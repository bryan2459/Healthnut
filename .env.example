# Generate a long, private value and keep it out of source control.
ADMIN_TOKEN=pass123456
PORT=3001
# Booking requests are emailed to this address.
BOOKING_NOTIFY_EMAIL=you@example.com
# Emails are only recorded in the email_log table unless this is set to enabled.
EMAIL_DELIVERY=enabled
# Resend SMTP (free tier). The password is your Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key
# Use onboarding@resend.dev until you verify your own domain in Resend.
EMAIL_FROM="Forme <onboarding@resend.dev>"
# Temporary: send all emails here until a domain is verified in Resend. Remove once verified.
EMAIL_REDIRECT_TO=you@example.com
PUBLIC_APP_URL=http://localhost:5173
# Production: PUBLIC_APP_URL=https://healthnut.dev
# Optional: directory for the SQLite file (point at a persistent disk in production).
# DATA_DIR=/var/data

